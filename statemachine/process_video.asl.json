{
  "Comment": "StreamDojo ProcessVideo: start exactly once -> MediaConvert -> Transcribe -> Translate -> ClipSensei drafts learning objectives for educator review.",
  "StartAt": "ParseUploadEvent",
  "States": {
    "ParseUploadEvent": {
      "Type": "Pass",
      "Comment": "Pull bucket, key and videoId out of the S3 'Object Created' event (key looks like raw/<videoId>.mp4)",
      "Parameters": {
        "bucket.$": "$.detail.bucket.name",
        "key.$": "$.detail.object.key",
        "videoId.$": "States.ArrayGetItem(States.StringSplit(States.ArrayGetItem(States.StringSplit($.detail.object.key, '/'), 1), '.'), 0)"
      },
      "Next": "MarkProcessing"
    },
    "MarkProcessing": {
      "Type": "Task",
      "Comment": "Idempotency: only move UPLOADING -> PROCESSING. A duplicate event (or a file uploaded without the API) fails the condition and stops here.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET processingStatus = :processing, processingStartedAt = :now",
        "ConditionExpression": "processingStatus = :uploading",
        "ExpressionAttributeValues": {
          ":processing": {
            "S": "PROCESSING"
          },
          ":uploading": {
            "S": "UPLOADING"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerErrorException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "Next": "AlreadyHandled"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "Transcode"
    },
    "AlreadyHandled": {
      "Type": "Succeed",
      "Comment": "Duplicate or unknown upload: nothing to do"
    },
    "Transcode": {
      "Type": "Task",
      "Comment": ".sync: Step Functions starts the MediaConvert job and waits for it to finish - without paying for idle compute",
      "Resource": "arn:aws:states:::mediaconvert:createJob.sync",
      "TimeoutSeconds": 3600,
      "Parameters": {
        "Role": "${MediaConvertRoleArn}",
        "UserMetadata": {
          "videoId.$": "$.videoId"
        },
        "StatusUpdateInterval": "SECONDS_60",
        "Settings": {
          "TimecodeConfig": {
            "Source": "ZEROBASED"
          },
          "Inputs": [
            {
              "FileInput.$": "States.Format('s3://{}/{}', $.bucket, $.key)",
              "TimecodeSource": "ZEROBASED",
              "VideoSelector": {},
              "AudioSelectors": {
                "Audio Selector 1": {
                  "DefaultSelection": "DEFAULT"
                }
              }
            }
          ],
          "OutputGroups": [
            {
              "Name": "HLS adaptive streaming",
              "OutputGroupSettings": {
                "Type": "HLS_GROUP_SETTINGS",
                "HlsGroupSettings": {
                  "SegmentLength": 6,
                  "MinSegmentLength": 0,
                  "Destination.$": "States.Format('s3://${ProcessedBucketName}/processed/{}/hls/index', $.videoId)"
                }
              },
              "Outputs": [
                {
                  "NameModifier": "_360p",
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 640,
                    "Height": 360,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "MaxBitrate": 1000000,
                        "SceneChangeDetect": "TRANSITION_DETECTION",
                        "GopSize": 2,
                        "GopSizeUnits": "SECONDS"
                      }
                    }
                  },
                  "AudioDescriptions": [
                    {
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 96000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ]
                },
                {
                  "NameModifier": "_720p",
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 1280,
                    "Height": 720,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "MaxBitrate": 3000000,
                        "SceneChangeDetect": "TRANSITION_DETECTION",
                        "GopSize": 2,
                        "GopSizeUnits": "SECONDS"
                      }
                    }
                  },
                  "AudioDescriptions": [
                    {
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 96000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ]
                },
                {
                  "NameModifier": "_1080p",
                  "ContainerSettings": {
                    "Container": "M3U8",
                    "M3u8Settings": {}
                  },
                  "VideoDescription": {
                    "Width": 1920,
                    "Height": 1080,
                    "CodecSettings": {
                      "Codec": "H_264",
                      "H264Settings": {
                        "RateControlMode": "QVBR",
                        "QvbrSettings": {
                          "QvbrQualityLevel": 7
                        },
                        "MaxBitrate": 6000000,
                        "SceneChangeDetect": "TRANSITION_DETECTION",
                        "GopSize": 2,
                        "GopSizeUnits": "SECONDS"
                      }
                    }
                  },
                  "AudioDescriptions": [
                    {
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 96000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Name": "Audio for Transcribe",
              "OutputGroupSettings": {
                "Type": "FILE_GROUP_SETTINGS",
                "FileGroupSettings": {
                  "Destination.$": "States.Format('s3://${ProcessedBucketName}/processed/{}/audio', $.videoId)"
                }
              },
              "Outputs": [
                {
                  "Extension": "m4a",
                  "ContainerSettings": {
                    "Container": "MP4",
                    "Mp4Settings": {}
                  },
                  "AudioDescriptions": [
                    {
                      "CodecSettings": {
                        "Codec": "AAC",
                        "AacSettings": {
                          "Bitrate": 96000,
                          "CodingMode": "CODING_MODE_2_0",
                          "SampleRate": 48000
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "Name": "Thumbnail",
              "OutputGroupSettings": {
                "Type": "FILE_GROUP_SETTINGS",
                "FileGroupSettings": {
                  "Destination.$": "States.Format('s3://${ProcessedBucketName}/processed/{}/thumb', $.videoId)"
                }
              },
              "Outputs": [
                {
                  "Extension": "jpg",
                  "ContainerSettings": {
                    "Container": "RAW"
                  },
                  "VideoDescription": {
                    "Width": 1280,
                    "Height": 720,
                    "CodecSettings": {
                      "Codec": "FRAME_CAPTURE",
                      "FrameCaptureSettings": {
                        "FramerateNumerator": 1,
                        "FramerateDenominator": 5,
                        "MaxCaptures": 1,
                        "Quality": 80
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "ResultSelector": {
        "durationMs.$": "$.Job.OutputGroupDetails[0].OutputDetails[0].DurationInMs"
      },
      "ResultPath": "$.transcode",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "MarkReady"
    },
    "MarkReady": {
      "Type": "Task",
      "Comment": "Record where the playable files are. The lesson can now stream.",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET processingStatus = :ready, hlsPath = :hls, audioPath = :audio, thumbnailPath = :thumb, durationMs = :duration, processedAt = :now",
        "ExpressionAttributeValues": {
          ":ready": {
            "S": "READY"
          },
          ":hls": {
            "S.$": "States.Format('processed/{}/hls/index.m3u8', $.videoId)"
          },
          ":audio": {
            "S.$": "States.Format('processed/{}/audio.m4a', $.videoId)"
          },
          ":thumb": {
            "S.$": "States.Format('processed/{}/thumb.0000000.jpg', $.videoId)"
          },
          ":duration": {
            "N.$": "States.Format('{}', $.transcode.durationMs)"
          },
          ":now": {
            "S.$": "$$.State.EnteredTime"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerErrorException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkFailed"
        }
      ],
      "Next": "StartTranscription"
    },
    "MarkFailed": {
      "Type": "Task",
      "Comment": "Any failure: record it on the lesson so the creator sees FAILED instead of a lesson stuck in PROCESSING",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET processingStatus = :failed, processingError = :error",
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "FAILED"
          },
          ":error": {
            "S.$": "$.error.Error"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerErrorException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ProcessingFailed"
    },
    "ProcessingFailed": {
      "Type": "Fail",
      "Error": "ProcessingFailed",
      "Cause": "See processingError on the lesson and this execution's history"
    },
    "StartTranscription": {
      "Type": "Task",
      "Comment": "Speech-to-text on the audio-only file, with English WebVTT subtitles",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:startTranscriptionJob",
      "Parameters": {
        "TranscriptionJobName.$": "States.Format('streamdojo-{}', $.videoId)",
        "LanguageCode": "en-GB",
        "Media": {
          "MediaFileUri.$": "States.Format('s3://${ProcessedBucketName}/processed/{}/audio.m4a', $.videoId)"
        },
        "OutputBucketName": "${ProcessedBucketName}",
        "OutputKey.$": "States.Format('processed/{}/transcript/', $.videoId)",
        "Subtitles": {
          "Formats": [
            "vtt"
          ],
          "OutputStartIndex": 1
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.captionError",
          "Next": "MarkCaptionsFailed"
        }
      ],
      "Next": "WaitForTranscription"
    },
    "WaitForTranscription": {
      "Type": "Wait",
      "Comment": "Transcribe has no .sync integration, so poll - waiting in Step Functions is free",
      "Seconds": 20,
      "Next": "CheckTranscription"
    },
    "CheckTranscription": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:getTranscriptionJob",
      "Parameters": {
        "TranscriptionJobName.$": "States.Format('streamdojo-{}', $.videoId)"
      },
      "ResultSelector": {
        "status.$": "$.TranscriptionJob.TranscriptionJobStatus"
      },
      "ResultPath": "$.transcription",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.captionError",
          "Next": "MarkCaptionsFailed"
        }
      ],
      "Next": "IsTranscriptionDone"
    },
    "IsTranscriptionDone": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.transcription.status",
          "StringEquals": "COMPLETED",
          "Next": "PrepareTranscript"
        },
        {
          "Variable": "$.transcription.status",
          "StringEquals": "FAILED",
          "Next": "MarkCaptionsFailed"
        }
      ],
      "Default": "WaitForTranscription"
    },
    "PrepareTranscript": {
      "Type": "Task",
      "Comment": "Clean transcript for ClipSensei + English subtitles; captionStatus = TRANSCRIBED",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${PrepareTranscriptFunctionArn}",
        "Payload": {
          "videoId.$": "$.videoId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.captionError",
          "Next": "MarkCaptionsFailed"
        }
      ],
      "Next": "SetLanguages"
    },
    "SetLanguages": {
      "Type": "Pass",
      "Result": [
        "fr",
        "es",
        "it",
        "el"
      ],
      "ResultPath": "$.languages",
      "Next": "TranslateAll"
    },
    "TranslateAll": {
      "Type": "Map",
      "Comment": "One translation per language, all four at the same time",
      "ItemsPath": "$.languages",
      "MaxConcurrency": 4,
      "ItemSelector": {
        "videoId.$": "$.videoId",
        "lang.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "TranslateOne",
        "States": {
          "TranslateOne": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${TranslateSubtitlesFunctionArn}",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Next": "TranslationFailed"
              }
            ],
            "End": true
          },
          "TranslationFailed": {
            "Type": "Pass",
            "Result": {
              "ok": false
            },
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Next": "MarkCaptionsReady"
    },
    "MarkCaptionsReady": {
      "Type": "Task",
      "Comment": "READY only if all 5 languages exist (en + 4); otherwise PARTIAL",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET captionStatus = :ready",
        "ConditionExpression": "size(subtitleLanguages) = :all",
        "ExpressionAttributeValues": {
          ":ready": {
            "S": "READY"
          },
          ":all": {
            "N": "5"
          }
        }
      },
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "DynamoDB.ConditionalCheckFailedException"
          ],
          "Next": "MarkCaptionsPartial"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.captionError",
          "Next": "MarkCaptionsFailed"
        }
      ],
      "Next": "GenerateObjectives"
    },
    "MarkCaptionsPartial": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET captionStatus = :partial",
        "ExpressionAttributeValues": {
          ":partial": {
            "S": "PARTIAL"
          }
        }
      },
      "ResultPath": null,
      "Next": "GenerateObjectives"
    },
    "MarkCaptionsFailed": {
      "Type": "Task",
      "Comment": "Captions failed but the video still streams: only captionStatus changes",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET captionStatus = :failed",
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "FAILED"
          }
        }
      },
      "ResultPath": null,
      "Next": "Done"
    },
    "Done": {
      "Type": "Succeed"
    },
    "GenerateObjectives": {
      "Type": "Task",
      "Comment": "ClipSensei (Bedrock) drafts learning objectives; the lesson joins the educator's DRAFTS queue",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${GenerateObjectivesFunctionArn}",
        "Payload": {
          "videoId.$": "$.videoId"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.objectivesError",
          "Next": "MarkObjectivesFailed"
        }
      ],
      "Next": "Done"
    },
    "MarkObjectivesFailed": {
      "Type": "Task",
      "Comment": "The video and captions still work; only objectivesStatus changes",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "${AppTableName}",
        "Key": {
          "PK": {
            "S.$": "States.Format('VIDEO#{}', $.videoId)"
          },
          "SK": {
            "S": "META"
          }
        },
        "UpdateExpression": "SET objectivesStatus = :failed",
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "FAILED"
          }
        }
      },
      "ResultPath": null,
      "Next": "Done"
    }
  }
}
